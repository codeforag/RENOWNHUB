# RENOWNHUB frontend environment variables
# Copy this file to `.env` and fill in your values.
#   cp .env.example .env
#
# All VITE_ variables are exposed to the browser bundle. NEVER put secrets here.
# Secrets live in Supabase Edge Function env (set via Supabase Dashboard → Edge Functions → Secrets).

# Supabase project URL (no trailing slash)
VITE_SUPABASE_URL=https://ycsssohaoedyyucldefb.supabase.co

# Supabase anon/public key (safe to expose — protected by RLS)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Inljc3Nzb2hhb2VkeXl1Y2xkZWZiIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODYwODI3MjEsImV4cCI6MjEwMTY1ODcyMX0.ZqFs-VSfZ8cbNlUS65_H0VmrEodhGKPoyiY-lTb_LPE

# === SECRETS — NEVER put these in .env. They live in Supabase Edge Function env. ===
# RESEND_API_KEY        = (your Resend API key)
# RESEND_FROM_EMAIL     = onboarding@resend.dev (or your verified domain)
# RESEND_FROM_NAME      = RENOWNHUB
# RAZORPAY_KEY_ID      = (your Razorpay key ID — public, but better to keep in edge)
# RAZORPAY_KEY_SECRET  = (your Razorpay key secret — server-side only)
# RAZORPAY_WEBHOOK_SECRET = (set in Razorpay dashboard webhook config)
# SUPABASE_URL          = (same as VITE_SUPABASE_URL)
# SUPABASE_ANON_KEY     = (same as VITE_SUPABASE_ANON_KEY)
# SUPABASE_SERVICE_ROLE_KEY = (server-side only — full DB access, NEVER expose)
# APP_BASE_URL          = https://your-production-domain.com
